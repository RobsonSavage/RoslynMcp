{
  "description": "Follow the active Codex workspace before Roslyn MCP calls.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__roslyn__.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "roslyn",
            "tool": "set_solution_root",
            "input": {
              "rootPath": "${cwd}",
              "warmUp": false,
              "hookOutput": true
            },
            "timeout": 120,
            "statusMessage": "Following the Codex workspace in RoslynMcp"
          }
        ]
      }
    ]
  }
}
